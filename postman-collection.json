{
	"info": {
		"_postman_id": "bola-security-gateway",
		"name": "BOLA Security Gateway Test Collection",
		"description": "Comprehensive test collection for BOLA security middleware with real attack simulations and monitoring",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
