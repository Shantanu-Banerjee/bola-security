		{
			"name": "🚨 IDOR Attack Tests",
			"item": [
				{
					"name": "Access Other User's Resource",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-ID",
								"value": "attacker456",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/gateway/test/resources/999",
							"host": ["{{baseUrl}}"],
							"path": ["api", "gateway", "test", "resources", "999"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Should be blocked - Status 403\", function () {",
									"    pm.response.to.have.status(403);",
									"});",
									"",
									"pm.test(\"Contains security error\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.error.type).to.eql(\"ACCESS_DENIED\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Multiple Resource Enumeration",
