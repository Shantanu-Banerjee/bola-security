	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Add timestamp for unique requests",
					"pm.globals.set(\"timestamp\", Date.now());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Log response time",
					"console.log(\"Response time: \" + pm.response.responseTime + \"ms\");",
					"",
					"// Check for security headers",
					"if (pm.response.headers.get(\"X-Security-Processed\") === \"true\") {",
					"    console.log(\"✅ Security processing confirmed\");",
					"}",
					"",
					"// Log gateway headers",
					"const gatewayVersion = pm.response.headers.get(\"X-Gateway-Version\");",
					"if (gatewayVersion) {",
					"    console.log(\"Gateway Version: \" + gatewayVersion);",
					"}"
				]
			}
		}
