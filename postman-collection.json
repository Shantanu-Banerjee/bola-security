	"item": [
		{
			"name": "🔐 Legitimate Access Tests",
			"item": [
				{
					"name": "Normal User Access",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-ID",
								"value": "user123",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/gateway/test/legitimate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "gateway", "test", "legitimate"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains success\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"success\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Resource Access (Owner)",
					"request": {
						"method": "GET",
						"header": [
							{
